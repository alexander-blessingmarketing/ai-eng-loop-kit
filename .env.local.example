# Vorlage für .env.local — hier stehen NUR Platzhalter.
#
# .env.local selbst ist permission-gesperrt: Claude liest und schreibt sie nicht.
# Wenn ein echter Wert gebraucht wird, nennt Claude im Chat den Schlüssel und
# woher der Wert kommt — eintragen tust du ihn selbst.
#
# Grundregel: hier stehen TEST-Keys, niemals Produktions-Keys.

# ─── Supabase ──────────────────────────────────────────────────────────
# Lokale Entwicklung: die Werte, die `supabase start` ausgibt.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Umgeht RLS. Nur serverseitig verwenden, nie an den Client geben.
# Gebraucht von: Rate-Limit-RPC, /api/health
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ─── App ───────────────────────────────────────────────────────────────
# Produktions-URL nach dem Deploy. Wird u.a. von der Kuma-Registrierung gelesen.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostHog (EU-Cloud) ────────────────────────────────────────────────
# Ohne Key laufen Analytics und OTLP-Logs schlicht nicht — kein Fehler.
NEXT_PUBLIC_POSTHOG_KEY=phc_dein_projekt_key
# Reverse-Proxy-Pfad aus next.config.ts; umgeht Adblocker.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Nur für Sourcemap-Upload beim Build. Müssen in Vercel Build-Time-Envs sein.
# Optional — siehe docs/production/posthog-sourcemaps.md
POSTHOG_PERSONAL_API_KEY=phx_dein_personal_api_key
POSTHOG_PROJECT_ID=12345

# ─── Uptime Kuma (Monitoring) ──────────────────────────────────────────
# Nur nötig für `npm run kuma:register`. Bevorzugt einen dedizierten Bot-User
# anlegen, keine Admin-Credentials.
KUMA_BASE_URL=https://kuma.example.com
KUMA_USERNAME=bot-user
KUMA_PASSWORD=dein-passwort

# Komma-separiert; werden beim Anlegen per Name aufgelöst und verknüpft.
KUMA_NOTIFICATION_NAMES=name-des-channels
# Status-Page, in der neue Monitore einsortiert werden.
KUMA_STATUS_PAGE_SLUG=status-page-slug
KUMA_STATUS_PAGE_GROUP=
